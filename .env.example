GEMINI_API_KEY=
# Mặc định: gemini-flash-latest (luôn trỏ tới bản Flash mới nhất)
GEMINI_MODEL=gemini-flash-latest
# Nên đặt khi deploy: chỉ ai nhập đúng mã mới tạo được câu hỏi bằng AI
TEACHER_CODE=
